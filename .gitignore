**/.DS_Store
Context/
.claude/

# Astro
node_modules/
# Also match a SYMLINK named node_modules. The trailing slash above only matches
# a real directory, so a symlink stages as a regular file and a committed link
# can silently replace a real install (this happened in dimagi-website).
node_modules
dist/
.astro/

# wrangler
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
